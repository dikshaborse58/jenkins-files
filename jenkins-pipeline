pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'mvn'
    }

    stages {

        stage('checkout') {
            steps {
                sh 'git clone https://github.com/dikshaborse58/jenkins-files.git'
                echo "Clonning is successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                  mvn clean package
                '''
            }
        }

        stage('Test') {
            steps {
                echo "Testing is successful"
            }
        }

        stage('Deploy') {
            steps {
                echo "Deployment is successful"
            }
        }
    }
}