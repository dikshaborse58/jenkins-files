pipeline {
    agent {
        label "diksha"
    }

    tools {
        maven 'mvn'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/dikshaborse58/jenkins-files.git'

                echo "Cloning is Successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                    mvn clean package
                '''
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war',
                                     fingerprint: true
                }
            }
        }

        stage('Artifacts to S3') {
            steps {
                sh '''
                    aws s3 cp target/*.war s3://jenkins-file-53/Artifacts/student.war
                '''
            }
        }
    }
}