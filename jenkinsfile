pipeline {
    agent {
        label 'diksha'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/dikshaborse58/jenkins-files.git'
            }
        }

        stage('Build') {
            steps {
                sh 'echo "Build started"'
                sh 'java -version'
            }
        }

    }
}